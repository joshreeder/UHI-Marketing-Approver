    "@tiptap/react": "^3.31.0",
    "@tiptap/starter-kit": "^3.31.0",
    "@vercel/blob": "^2.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "diff": "^9.0.0",
    "domhandler": "^6.0.1",
    "drizzle-orm": "^0.45.2",
    "htmlparser2": "^12.0.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.39.0",
    "mammoth": "^1.12.2",
    "next": "15.5.25",
    "next-themes": "^0.4.6",
